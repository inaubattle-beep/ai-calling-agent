# Application Environment
APP_ENV=development
DEV_MODE=true
LOG_LEVEL=INFO

# Server & Gateway
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=3000

# Database & Redis
# In DEV_MODE, SQLite is used by default if DATABASE_URL is empty or sqlite:///
DATABASE_URL=sqlite+aiosqlite:///./data/ai_calling.db
# For production PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/ai_calling
REDIS_URL=redis://localhost:6379/0

# PBX / Asterisk Integration
PBX_HOST=127.0.0.1
PBX_PORT=8088
PBX_ARI_USERNAME=ai-agent
PBX_ARI_PASSWORD=changeme_ari_secret
PBX_ARI_APP=ai-agent

# SIP Extension Configuration
SIP_EXTENSION=7000
SIP_USERNAME=ai-agent
SIP_PASSWORD=changeme_sip_secret
SIP_DOMAIN=127.0.0.1

# AI Providers
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

STT_PROVIDER=mock
STT_API_KEY=
STT_MODEL=whisper-1

TTS_PROVIDER=mock
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Security & Recording
RECORD_CALLS=false
JWT_SECRET=super_secret_jwt_key_bilingual_ai_calling_2026
